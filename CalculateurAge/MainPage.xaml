<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}"
                   Placeholder="Votre nom"/>

            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance, Mode=TwoWay}"/>

            <Button Text="Calculer"
                    Command="{Binding CalculerCommand}"/>
            <Button Text="Effacer"
                    Command="{Binding EffacerCommand}"/>

            <VerticalStackLayout Spacing="6"
                                 IsVisible="{Binding ResultatVisible}">
                <Label Text="{Binding Resultat}" FontSize="20"/>
                <Label Text="{Binding Message}" FontSize="18"
                       FontAttributes="Bold"/>
                <Label Text="{Binding JoursRestants}" FontSize="16"/>
            </VerticalStackLayout>

            <Label Text="Historique" FontSize="18"
                   FontAttributes="Bold" Margin="0,16,0,0"/>
            <VerticalStackLayout Spacing="4"
                                 BindableLayout.ItemsSource="{Binding Historique}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" FontSize="14"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>